---
import Layout from "../layouts/Layout.astro";
import Cuisines from "../components/Cuisines.astro";
---

<Layout
  title="Cuisines"
  fullTitle="The Eight Great Chinese Cuisines — Flavors, Techniques & What to Order"
  description="China is not one menu but eight regional schools. Learn the story, signature techniques and must-order dishes of Sichuan, Cantonese, Shandong, Jiangsu, Hunan, Zhejiang, Fujian and Anhui cuisine."
>
  <Cuisines />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.chinese-menus.com" },
      { "@type": "ListItem", "position": 2, "name": "Cuisines", "item": "https://www.chinese-menus.com/cuisines/" },
    ],
  })} />
</Layout>
