---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import CityPicker from "../components/CityPicker.tsx";
import MenuExplorer from "../components/MenuExplorer.tsx";
import TravelerTypes from "../components/TravelerTypes.astro";
import MenuAnatomy from "../components/MenuAnatomy.astro";
import CityMenus from "../components/CityMenus.astro";
import Cuisines from "../components/Cuisines.astro";
import TasteGuide from "../components/TasteGuide.astro";
import AtTheTable from "../components/AtTheTable.astro";
import WhyTrust from "../components/WhyTrust.astro";
import FAQ from "../components/FAQ.astro";
import { execSync } from "node:child_process";
import { dishes } from "../data/dishes";

const title = "Chinese Menu: Read It, Order It, Eat It";

// Canonical homepage URL without trailing slash (root-domain exception, see
// technology-seo-check rule 2). Schema.org urls must match the canonical form.
const siteUrl = Astro.site!.href.replace(/\/$/, "");

// Truthful last-modified for the Article schema: the latest commit date, so
// content changes update it automatically. Falls back to the build date when
// the repository is not available (e.g. zip uploads).
let dateModified = new Date().toISOString().slice(0, 10);
try {
  dateModified = execSync("git log -1 --format=%cd --date=short", { encoding: "utf8" }).trim();
} catch {}

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Chinese Menu",
  "url": siteUrl,
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Signature Chinese dishes for travelers",
  "itemListElement": dishes.map((dish, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": dish.englishName,
    "alternateName": `${dish.chineseName} ${dish.pinyin}`,
    "image": new URL(dish.image, Astro.site!).href,
    "description": dish.description,
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description":
    "Learn how to read a Chinese menu, browse six city signature menus, and order with confidence — dish names, prices and useful phrases for your China trip.",
  "author": { "@type": "Person", "name": "Chinese Menu Editorial Team" },
  "publisher": { "@type": "Organization", "name": "Chinese Menu" },
  "reviewedBy": { "@type": "Organization", "name": "Chinese Menu" },
  "dateModified": dateModified,
  "mainEntityOfPage": siteUrl,
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Chinese Menu Explorer",
  "url": siteUrl,
  "applicationCategory": "TravelApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList":
    "Search dishes by English, Chinese or pinyin; filter by diet and region; generate a printable point-to-order card",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ChineseMenu",
  "url": siteUrl,
  "description":
    "A traveler's Chinese menu decoder — browse, translate and order real Chinese dishes.",
  "sameAs": [
    "https://github.com/jiusongvip",
    "https://x.com/chinesemenus",
    "https://www.linkedin.com/company/chinese-menu",
  ],
};
---

<Layout
  title="Chinese Menu"
  fullTitle="Chinese Menu: Read It, Order It, Eat It (2026)"
  description="Learn how to read a Chinese menu, browse six city signature menus, and order with confidence — dish names, prices and useful phrases for your China trip."
>
  <Hero />

  <Marquee />

  <Stats />

  <CityPicker client:visible />

  <MenuExplorer client:visible />

  <TravelerTypes />

  <MenuAnatomy />

  <CityMenus />

  <Cuisines />

  <TasteGuide />

  <AtTheTable />

  <WhyTrust />

  <FAQ />

  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</Layout>
