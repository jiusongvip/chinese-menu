---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Stats from "../components/Stats.astro";
import CityPicker from "../components/CityPicker.tsx";
import MenuExplorer from "../components/MenuExplorer.tsx";
import TravelerTypes from "../components/TravelerTypes.astro";
import MenuAnatomy from "../components/MenuAnatomy.astro";
import CityMenus from "../components/CityMenus.astro";
import TasteGuide from "../components/TasteGuide.astro";
import AtTheTable from "../components/AtTheTable.astro";
import WhyTrust from "../components/WhyTrust.astro";
import { execSync } from "node:child_process";
import { dishes } from "../data/dishes";

const faqTeaser = [
  { q: "How much does food cost in China?", a: "Street snacks 8-30 RMB, casual meals 40-90 RMB per person, and a Peking duck dinner 120-220 RMB or more." },
  { q: "How do I order if I don't speak Chinese?", a: "Use the phrase cards, point to a photo on this page, or show the Chinese dish name to the staff." },
  { q: "Is Chinese street food safe?", a: "Choose busy stalls with fast turnover and high-heat cooking, drink bottled water, and carry allergy phrases in Chinese." },
  { q: "What are the eight great Chinese cuisines?", a: "Sichuan, Cantonese, Shandong, Jiangsu, Hunan, Zhejiang, Fujian and Anhui — each tied to a region and its signature flavors." },
  { q: "Do I need to tip in China?", a: "No. Tipping is not expected in restaurants or taxis, and some places may politely refuse it." },
  { q: "Is tap water safe to drink?", a: "No — drink bottled or boiled water, and use bottled water for brushing teeth if you are sensitive." },
];

const title = "Chinese Menu: Read It, Order It, Eat It";

// Canonical homepage URL without trailing slash (root-domain exception, see
// technology-seo-check rule 2). Schema.org urls must match the canonical form.
const siteUrl = Astro.site!.href.replace(/\/$/, "");

// Truthful last-modified for the Article schema: the latest commit date, so
// content changes update it automatically. Falls back to the build date when
// the repository is not available (e.g. zip uploads).
let dateModified = new Date().toISOString().slice(0, 10);
try {
  dateModified = execSync("git log -1 --format=%cd --date=short", { encoding: "utf8" }).trim();
} catch {}

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Chinese Menu",
  "url": siteUrl,
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Signature Chinese dishes for travelers",
  "itemListElement": dishes.map((dish, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": dish.englishName,
    "alternateName": `${dish.chineseName} ${dish.pinyin}`,
    "image": new URL(dish.image, Astro.site!).href,
    "description": dish.description,
  })),
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description":
    "Learn how to read a Chinese menu, browse six city signature menus, and order with confidence — dish names, prices and useful phrases for your China trip.",
  "author": { "@type": "Person", "name": "Chinese Menu Editorial Team" },
  "publisher": { "@type": "Organization", "name": "Chinese Menu" },
  "reviewedBy": { "@type": "Organization", "name": "Chinese Menu" },
  "dateModified": dateModified,
  "mainEntityOfPage": siteUrl,
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Chinese Menu Explorer",
  "url": siteUrl,
  "applicationCategory": "TravelApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList":
    "Search dishes by English, Chinese or pinyin; filter by diet and region; generate a printable point-to-order card",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ChineseMenu",
  "url": siteUrl,
  "description":
    "A traveler's Chinese menu decoder — browse, translate and order real Chinese dishes.",
  "sameAs": [
    "https://github.com/jiusongvip",
    "https://x.com/chinesemenus",
    "https://www.linkedin.com/company/chinese-menu",
  ],
};
---

<Layout
  title="Chinese Menu"
  fullTitle="Chinese Menu: Read It, Order It, Eat It (2026)"
  description="Learn how to read a Chinese menu, browse six city signature menus, and order with confidence — dish names, prices and useful phrases for your China trip."
>
  <Hero />

  <Marquee />

  <Stats />

  <CityPicker client:load />

  <MenuExplorer client:load />

  <TravelerTypes />

  <MenuAnatomy />

  <CityMenus />

  <section id="cuisines" class="border-y border-line bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12">
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-accent-600">Regional schools</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-5xl">
            The eight great cuisines.
          </h2>
        </div>
        <p class="max-w-md text-base leading-relaxed text-muted md:text-lg">
          Chinese food is not one menu but eight regional schools. Spot the
          character on a sign or menu and you already know the flavors to expect.
        </p>
      </div>
      <a
        href="/cuisines/"
        class="mt-8 inline-flex items-center gap-2 bg-ink px-5 py-3 text-sm font-medium text-white transition-transform active:scale-[0.98]"
      >
        Explore all eight cuisines
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <TasteGuide />

  <AtTheTable />

  <WhyTrust />

  <section id="faq" class="border-t border-line bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12">
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-accent-600">FAQ</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-5xl">
            Quick answers before you travel.
          </h2>
        </div>
        <p class="max-w-md text-base leading-relaxed text-muted md:text-lg">
          The common questions travelers ask before a food trip through China —
          from paying and tipping to allergies, halal and chopsticks.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {faqTeaser.map((item) => (
          <details class="group border border-line bg-paper p-5">
            <summary class="cursor-pointer list-none text-lg font-medium">
              {item.q}
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted">{item.a}</p>
          </details>
        ))}
      </div>

      <a
        href="/faq/"
        class="mt-8 inline-flex items-center gap-2 bg-ink px-5 py-3 text-sm font-medium text-white transition-transform active:scale-[0.98]"
      >
        Read all FAQ
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
</Layout>
