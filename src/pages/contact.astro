---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact"
  fullTitle="Contact ChineseMenu — Questions, Corrections & Suggestions"
  description="Contact the ChineseMenu editorial team with questions, corrections or dish suggestions. We read every message and respond within a few business days."
>
  <main class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Contact us</h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      We are happy to hear from you about four things: dish questions, requests
      for more detail on a guide, corrections when you spot an error, and general
      feedback. Suggestions for new dishes or cities are especially welcome.
    </p>

    <div class="mt-10 space-y-8 text-base leading-relaxed text-muted">
      <section>
        <h2 class="text-2xl font-semibold text-ink">Email</h2>
        <p class="mt-3">
          <a
            href="mailto:contact@chinese-menus.com"
            class="text-accent-600 hover:text-accent-700"
            >contact@chinese-menus.com</a
          >
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-ink">What to include</h2>
        <ul class="mt-3 list-disc space-y-2 pl-6">
          <li>The page URL or dish name you have a question about</li>
          <li>Your question or suggestion, with as much detail as you like</li>
          <li>Relevant context, such as the city or restaurant you visited</li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold text-ink">Response time</h2>
        <p class="mt-3">
          We read every message and reply within a few business days. Corrections
          are verified against real menus and updated in the next quarterly price
          refresh.
        </p>
      </section>
    </div>
  </main>
</Layout>
