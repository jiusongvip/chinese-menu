---
import Layout from "../layouts/Layout.astro";
import FAQ from "../components/FAQ.astro";
---

<Layout
  title="FAQ"
  fullTitle="Chinese Food FAQ — Costs, Ordering, Etiquette & Safety"
  description="Answers to the most common questions travelers ask before a food trip through China: prices, how to order without Chinese, street food safety, halal, allergies, chopsticks and tipping."
>
  <FAQ />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.chinese-menus.com" },
      { "@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://www.chinese-menus.com/faq/" },
    ],
  })} />
</Layout>
