---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="This page could not be found."
  noindex
>
  <main class="mx-auto flex min-h-[70dvh] max-w-7xl flex-col items-center justify-center px-4 text-center sm:px-6 lg:px-8">
    <h1 class="text-5xl font-semibold tracking-tight md:text-7xl">404</h1>
    <p class="mt-4 max-w-md text-lg text-muted">
      This page could not be found.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center justify-center bg-ink px-6 py-3.5 text-sm font-medium text-white"
    >
      Back to the menu
    </a>
  </main>
</Layout>
