---
const year = new Date().getFullYear();
---

<footer class="bg-ink text-zinc-400">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.2fr_0.8fr_0.8fr] lg:px-8">
    <div>
      <a href="/" class="text-lg font-semibold text-white">
        Chinese<span class="text-accent-500">Menu</span>
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed">
        Your Chinese menu 鈥?read the dish, know the price, and order with confidence.
      </p>
    </div>

    <div>
      <h3 class="text-sm font-medium text-white">Explore</h3>
      <div class="mt-4 space-y-3 text-sm">
        <a href="/#city-menus" class="block hover:text-white">City menus</a>
        <a href="/#explorer" class="block hover:text-white">Dishes</a>
        <a href="/#cuisines" class="block hover:text-white">Cuisines</a>
        <a href="/#taste" class="block hover:text-white">Tastes</a>
        <a href="/#at-the-table" class="block hover:text-white">At the table</a>
      </div>
    </div>

    <div>
      <h3 class="text-sm font-medium text-white">Site</h3>
      <div class="mt-4 space-y-3 text-sm">
        <a href="/#faq" class="block hover:text-white">FAQ</a>
        <a href="/privacy-policy/" class="block hover:text-white">Privacy Policy</a>
        <a href="mailto:contact@chinese-menus.com" class="block hover:text-white">Contact</a>
      </div>
    </div>
  </div>
  <div class="border-t border-zinc-800 px-4 py-6 text-center text-sm text-zinc-500">
    &copy; {year} ChineseMenu. All rights reserved.
  </div>
</footer>
