---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  dark?: boolean;
}

const { eyebrow, title, description, dark } = Astro.props;
---

<div
  data-reveal
  class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12"
>
  <div class="max-w-2xl">
    {eyebrow && (
      <p
        class={`text-sm font-medium ${
          dark ? "text-accent-500" : "text-accent-600"
        }`}
      >
        {eyebrow}
      </p>
    )}
    <h2
      class={`mt-3 text-3xl font-semibold tracking-tight md:text-5xl ${
        dark ? "text-white" : ""
      }`}
    >
      {title}
    </h2>
  </div>
  {description && (
    <p
      class={`max-w-md text-base leading-relaxed md:text-lg ${
        dark ? "text-zinc-300" : "text-muted"
      }`}
    >
      {description}
    </p>
  )}
</div>
