---
import { dishes } from "../data/dishes";

// Every dish name appears twice so the -50% loop looks seamless.
const items = dishes.slice(0, 14);
---

<div
  aria-hidden="true"
  class="marquee overflow-hidden border-b border-line bg-white py-4"
>
  <div class="marquee-track">
    {[0, 1].map((copy) => (
      <div
        key={copy}
        class="flex shrink-0 items-center"
      >
        {items.map((dish) => (
          <span
            key={`${copy}-${dish.slug}`}
            class="flex items-center whitespace-nowrap text-base font-semibold tracking-tight"
          >
            <span class="px-5 text-ink">{dish.englishName}</span>
            <span class="text-2xl text-accent-600">{dish.chineseName}</span>
            <span class="px-5 text-xs font-medium uppercase tracking-widest text-muted">
              {dish.pinyin.split(" ")[0]}
            </span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
