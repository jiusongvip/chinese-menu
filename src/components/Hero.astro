---
const heroImage = "/images/hero-round-table.webp";
---

  <section class="relative overflow-hidden border-b border-line bg-paper">
    <div
      class="relative mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:min-h-[calc(100dvh-4rem)] lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16 lg:px-8 lg:py-24"
    >
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-medium tracking-wide text-accent-600">
        Your Chinese menu
      </p>
      <h1 class="mt-4 text-5xl font-semibold tracking-tighter leading-[1.02] sm:text-6xl lg:text-7xl">
        Read any <span class="text-accent-600">Chinese menu</span>, order with
        confidence.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted md:text-xl">
        One menu at a time — read the dish, know the price, and point with confidence
        in any Chinese restaurant.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="/#explorer"
          class="inline-flex items-center justify-center bg-ink px-6 py-3.5 text-sm font-medium text-white transition-transform hover:bg-accent-600 active:scale-[0.98]"
        >
          Search the menu
        </a>
        <a
          href="/#anatomy"
          class="inline-flex items-center justify-center border border-line bg-white px-6 py-3.5 text-sm font-medium text-ink transition-colors hover:border-accent-500 hover:bg-accent-50"
        >
          How to read a menu
        </a>
      </div>
      <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
        <span>Independent picks</span>
        <span>No sponsored dishes</span>
        <span>Prices checked quarterly</span>
      </div>
    </div>

    <div class="relative" data-reveal style="--reveal-delay: 150ms">
      <img
        src={heroImage}
        alt="A round table filled with Chinese dishes"
        class="aspect-[4/3] w-full border border-line bg-white object-cover shadow-2xl shadow-ink/15"
        width="1080"
        height="813"
        fetchpriority="high"
      />

      <!-- rotating stickers -->
      <div
        class="sticker absolute -left-5 -top-6 flex h-28 w-28 items-center justify-center rounded-full bg-accent-600 text-white shadow-xl"
      >
        <span class="text-center text-xs font-semibold uppercase leading-tight tracking-widest">
          Pinyin<br /><span class="text-2xl font-semibold">拼音</span>
        </span>
      </div>
      <div
        class="sticker absolute -right-4 top-1/4 flex h-24 w-24 items-center justify-center rounded-full bg-ink text-white shadow-xl [animation-duration:13s]"
      >
        <span class="text-center text-[10px] font-semibold uppercase leading-tight tracking-widest">
          Prices<br /><span class="text-xl font-semibold">¥ 价格</span>
        </span>
      </div>
      <div
        class="sticker absolute -bottom-6 left-1/4 flex h-24 w-24 items-center justify-center rounded-full border-2 border-accent-500 bg-white text-ink shadow-xl [animation-duration:19s]"
      >
        <span class="text-center text-[10px] font-semibold uppercase leading-tight tracking-widest">
          Veg&nbsp;OK<br /><span class="text-xl font-semibold">素食</span>
        </span>
      </div>
    </div>
  </div>

  <div class="border-t border-line bg-white">
    <div
      class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 text-sm text-muted sm:px-6 lg:px-8"
    >
      <span>Real dishes, real menu words.</span>
      <span class="hidden sm:inline">English + Chinese + pinyin</span>
    </div>
  </div>
</section>
