---
import SectionHeader from "./SectionHeader.astro";
import { cuisines, dishes } from "../data/dishes";

// Dish names that exist in the explorer data — these get deep links that
// pre-fill the search box (/?q=name#explorer). "hotpot" is a display alias
// for the dish whose English name is "Sichuan Hotpot".
const linkableDishes = new Set([
  ...dishes.map((d) => d.englishName.toLowerCase()),
  "hotpot",
]);

const extras: Record<string, { detail: string; techniques: string; tip: string }> = {
  Sichuan: {
    detail:
      "China's most famous cuisine abroad, built on má (numbing peppercorn) and là (chili) — málà. Bold, fiery and savory, from chili bean paste, garlic and fermented flavors.",
    techniques: "Dry-frying (干煸) · water-boiling (水煮) · twice-cooking (回锅)",
    tip: "Ask for 'wēi là' (mild) or 'bú yào là' (no spice). Most dishes can be dialed down.",
  },
  Cantonese: {
    detail:
      "Guangdong's cuisine prizes freshness — 'eat in Guangzhou'. Light, clean flavors via steaming, poaching and quick stir-frying. Dim sum is its famous morning ritual.",
    techniques: "Steaming (蒸) · poaching (白灼) · roasting (烧腊)",
    tip: "The safest starting point — mostly mild and light, with plenty of seafood and vegetables.",
  },
  Shandong: {
    detail:
      "One of China's oldest, most influential cuisines, from the coastal north. Salty, savory, seafood-forward, with rich broths and precise knife work.",
    techniques: "Quick-frying (爆) · braising · broth-building",
    tip: "Generous portions and savory depth. Dumplings here are a meal, not a side.",
  },
  Jiangsu: {
    detail:
      "Refined lower-Yangtze cuisine: soft textures, gentle sweetness and knife art. Subtle and sweet-savory, like red-braised pork.",
    techniques: "Red-braising (红烧) · slow-stewing · fine slicing",
    tip: "For delicate, slightly sweet flavors, this is your region. Xiaolongbao started here before Shanghai.",
  },
  Hunan: {
    detail:
      "Sichuan's spicier cousin — bright, sour, very hot, using fresh chilies plus smoked and cured foods. Mao's favorite red-braised pork comes from here.",
    techniques: "Smoking · pickling · chili stir-frying",
    tip: "Hunan heat is direct, not numbing. Lessen it with 'shǎo fàng làjiāo'.",
  },
  Zhejiang: {
    detail:
      "Elegant, clean Hangzhou cuisine: fresh, light, slightly sweet, favoring freshwater fish, bamboo and rice wine, with delicate presentation.",
    techniques: "Quick-steaming · wine-braising · gentle simmering",
    tip: "Dongpo pork is the star — rich but not spicy, an easy crowd-pleaser.",
  },
  Fujian: {
    detail:
      "Broth-obsessed and umami-rich, home of 'Buddha Jumps Over the Wall' and many seafood soups. Also invented shacha sauce and oolong tea.",
    techniques: "Soup-building · slow-simmering · seafood handling",
    tip: "Order a broth or soup — that's where Fujian cooking shines.",
  },
  Anhui: {
    detail:
      "Rustic mountain cuisine of wild herbs, cured ham and long braising. Earthier, less sweet, known for fermented 'stinky' specialties.",
    techniques: "Long braising · smoking · fermenting",
    tip: "An acquired taste. Try stinky mandarin fish with an open mind — aroma stronger than flavor.",
  },
};
---

<section id="cuisines" class="border-y border-line bg-white">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
    <SectionHeader
      eyebrow="Regional schools"
      title="The eight great cuisines."
      description="Chinese food is not one menu but eight regional schools. Spot the character on a sign or menu and you already know the flavors to expect — expand each one to learn its story, techniques and what to order."
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2" data-reveal>
      {cuisines.map((cuisine) => {
        const extra = extras[cuisine.name];
        return (
          <details class="group border border-line bg-white p-6">
            <summary class="flex cursor-pointer list-none items-baseline gap-3">
              <span class="text-3xl font-semibold leading-none text-accent-600">
                {cuisine.character}
              </span>
              <div>
                <h3 class="text-lg font-semibold">{cuisine.name}</h3>
                <p class="text-sm text-muted">{cuisine.pinyin} · {cuisine.taste}</p>
              </div>
              <span class="ml-auto text-2xl font-light text-accent-600 group-open:hidden">+</span>
              <span class="ml-auto hidden text-2xl font-light text-accent-600 group-open:inline">−</span>
            </summary>

            <div class="mt-4 space-y-3 border-t border-line pt-4">
              <p class="text-sm leading-relaxed text-muted">{extra.detail}</p>
              <p class="text-sm text-muted">
                <span class="font-medium text-ink">Techniques:</span> {extra.techniques}
              </p>
              <p class="text-sm">
                <span class="text-muted">Cities:</span>{" "}
                <a href="/#city-menus" class="text-ink underline-offset-2 hover:text-accent-600 hover:underline">
                  {cuisine.city}
                </a>
              </p>
              <p class="text-sm">
                <span class="text-muted">Try:</span>{" "}
                {cuisine.dishes.split(", ").map((dishName, i) => {
                  const key = dishName.toLowerCase();
                  const linkable = linkableDishes.has(key);
                  return (
                    <>
                      {i > 0 && ", "}
                      {linkable ? (
                        <a
                          href={`/?q=${encodeURIComponent(key)}#explorer`}
                          class="font-medium text-accent-600 underline-offset-2 hover:underline"
                        >
                          {dishName}
                        </a>
                      ) : (
                        <span class="text-ink">{dishName}</span>
                      )}
                    </>
                  );
                })}
              </p>
              <div class="rounded border border-line bg-paper p-3">
                <p class="text-sm font-semibold text-accent-600">Ordering tip</p>
                <p class="mt-1 text-sm leading-relaxed text-muted">{extra.tip}</p>
              </div>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>
