---
import SectionHeader from "./SectionHeader.astro";
import { cities } from "../data/dishes";

const signatureDishes: Record<string, { zh: string; en: string; price: string }[]> = {
  beijing: [
    { zh: "北京烤鸭", en: "Peking Duck", price: "¥168-398" },
    { zh: "炸酱面", en: "Zhajiangmian", price: "¥15-32" },
    { zh: "酸梅汤", en: "Sour Plum Drink", price: "¥3-8" },
  ],
  shanghai: [
    { zh: "小笼包", en: "Xiaolongbao", price: "¥12-38" },
    { zh: "生煎包", en: "Sheng Jian Bao", price: "¥10-24" },
    { zh: "葱油饼", en: "Scallion Pancakes", price: "¥8-20" },
  ],
  chengdu: [
    { zh: "麻婆豆腐", en: "Mapo Tofu", price: "¥18-42" },
    { zh: "宫保鸡丁", en: "Kung Pao Chicken", price: "¥28-58" },
    { zh: "担担面", en: "Dan Dan Noodles", price: "¥16-36" },
  ],
  xian: [
    { zh: "肉夹馍", en: "Roujiamo", price: "¥8-20" },
    { zh: "羊肉串", en: "Lamb Skewers", price: "¥5-12" },
    { zh: "牛肉面", en: "Beef Noodle Soup", price: "¥22-48" },
  ],
  guangzhou: [
    { zh: "叉烧", en: "Char Siu", price: "¥28-68" },
    { zh: "虾饺", en: "Har Gow", price: "¥15-32" },
    { zh: "云吞汤", en: "Wonton Soup", price: "¥18-38" },
  ],
  chongqing: [
    { zh: "火锅", en: "Sichuan Hotpot", price: "¥88-188" },
    { zh: "酸菜鱼", en: "Suan Cai Yu", price: "¥48-98" },
    { zh: "毛血旺", en: "Maoxuewang", price: "¥45-88" },
  ],
};

const extras: Record<string, { detail: string; order: string; diet: string }> = {
  beijing: {
    detail:
      "Imperial China on a plate — duck carved tableside, wheat noodles with bean paste, big breakfasts of jianbing and soy milk. Savory, salty, northern-style portions.",
    order:
      "Order Peking duck by half or whole and watch it carve. Wrap in pancakes with scallion and sweet bean sauce.",
    diet:
      "Strong halal tradition around Niujie (牛街) and Buddhist veg temples. Say 'sù shí' / 'qīng zhēn'.",
  },
  chengdu: {
    detail:
      "Capital of Sichuan and a UNESCO City of Gastronomy. All about málà, balanced by sweet water noodles, tea houses and slow living.",
    order:
      "Try mapo tofu over rice to cut heat; graduate to málà hot pot later. Many dishes 'wēi là' (mild).",
    diet:
      "Great for vegetarians — tofu, veg stir-fries, Buddhist 'sù' spots everywhere. Say 'bú yào là'.",
  },
  xian: {
    detail:
      "Eastern end of the Silk Road — wheat flatbreads, lamb, cumin, and a huge Muslim Quarter making it China's halal capital. Hearty and cheap.",
    order:
      "Roujiamo (the 'Chinese burger') is a must, with hand-pulled noodles or lamb soup. Eat standing like a local.",
    diet:
      "The Muslim Quarter is almost entirely halal. Vegetarians find noodles and veg dishes, but lamb dominates.",
  },
  shanghai: {
    detail:
      "Sweet, refined 'benbang' cuisine. Soup dumplings, pan-fried buns and scallion pancakes are the stars — a snack or long brunch.",
    order:
      "For xiaolongbao, bite a hole, sip the broth, dip in black vinegar with ginger. Never bite whole — scalding inside.",
    diet:
      "Plenty of pork and sugar. Look for 'sù' restaurants and ask clearly for vegetable-only.",
  },
  guangzhou: {
    detail:
      "Birthplace of Cantonese cuisine and dim sum. Classics — char siu, har gow, white cut chicken — are mild and approachable. Morning dim sum is a ritual.",
    order:
      "Go before noon: har gow, siu mai, char siu bao, egg tarts. Order tea first, then baskets of 3-4.",
    diet:
      "Most veg- and seafood-friendly. Steamed fish, greens, rice everywhere; watch oyster sauce if strictly vegan.",
  },
  chongqing: {
    detail:
      "Hot pot's spiritual home — a mountain city where everything swims in chili oil and Sichuan peppercorn. China's boldest, spiciest food, around a communal pot.",
    order:
      "Order a 'yuānyāng' pot — half spicy, half mild — first time. Dip in sesame oil with garlic to cool.",
    diet:
      "Vegetarian hot pot uses clear broth and veg platters, but it's meat-heavy by default. Ask 'qīng tāng' for no spice.",
  },
};
---

<section id="city-menus" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
  <SectionHeader
    eyebrow="City menus"
    title="Six cities, six signature menus."
    description="Think of each city as a restaurant with a menu of its own. Order the bold items, and you have tasted the place — plus where to find them, what to budget, and how to order like someone who knows."
  />
  
  <div class="mt-10 overflow-x-auto border border-line bg-white" data-reveal>
    <table class="w-full min-w-[640px] text-left text-sm">
      <thead class="bg-paper text-muted">
        <tr>
          <th class="px-4 py-3 font-medium">City</th>
          <th class="px-4 py-3 font-medium">Best for</th>
          <th class="px-4 py-3 font-medium">Signature dishes</th>
          <th class="px-4 py-3 font-medium">Budget</th>
          <th class="px-4 py-3 font-medium">Days</th>
        </tr>
      </thead>
      <tbody>
        {cities.map((city) => (
          <tr class="border-t border-line">
            <td class="px-4 py-3 font-semibold">{city.english}</td>
            <td class="px-4 py-3 text-muted">{city.bestFor}</td>
            <td class="px-4 py-3 text-muted">{city.signature}</td>
            <td class="px-4 py-3 text-muted">{city.budget}</td>
            <td class="px-4 py-3 text-muted">{city.days}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {cities.map((city) => {
      const cityDishes = signatureDishes[city.id] ?? [];
      const extra = extras[city.id];
      return (
        <article class="flex flex-col border border-line bg-white p-6">
          <div class="border-b border-line pb-4">
            <p class="text-sm text-muted">{city.name}</p>
            <h3 class="mt-1 text-2xl font-semibold">{city.english}</h3>
            <p class="mt-2 text-sm text-accent-600">{city.bestFor}</p>
          </div>

          <div class="mt-4 space-y-3">
            {cityDishes.map((dish) => (
              <div class="flex items-baseline gap-2">
                <span class="font-medium">{dish.en}</span>
                <span class="text-sm text-muted">{dish.zh}</span>
                <span class="flex-1 border-b border-dotted border-line"></span>
                <span class="shrink-0 text-sm font-semibold text-accent-600">{dish.price}</span>
              </div>
            ))}
          </div>

          <div class="mt-5 space-y-1.5 border-t border-line pt-4 text-sm text-muted">
            <p><span class="font-medium text-ink">Where to eat:</span> {city.foodStreets}</p>
            <p><span class="font-medium text-ink">How long:</span> {city.days}</p>
            <p><span class="font-medium text-ink">Budget:</span> {city.budget}</p>
          </div>

          <details class="group mt-4 border-t border-line pt-4">
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-accent-600">
              What to know before you order
              <span class="text-xl font-light group-open:hidden">+</span>
              <span class="hidden text-xl font-light group-open:inline">−</span>
            </summary>
            <div class="mt-3 space-y-3 text-sm leading-relaxed text-muted">
              <p>{extra.detail}</p>
              <div class="rounded border border-line bg-paper p-3">
                <p class="font-medium text-ink">How to order</p>
                <p class="mt-1">{extra.order}</p>
              </div>
              <div class="rounded border border-line bg-paper p-3">
                <p class="font-medium text-ink">Dietary notes</p>
                <p class="mt-1">{extra.diet}</p>
              </div>
            </div>
          </details>
        </article>
      );
    })}
  </div>
</section>
